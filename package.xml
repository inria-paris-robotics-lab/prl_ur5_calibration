<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>prl_ur5_calibration</name>
  <version>0.1.0</version>
  <description>The prl_ur5_calibration package for calibrating the mantis robot in the PRL lab</description>
  <maintainer email="etienne.arlaud@inria.fr">Etienne Arlaud</maintainer>
  <author email="etienne.arlaud@inria.fr">Etienne Arlaud</author>
  <author email="timothee.carecchio@inria.fr">Timothee Carecchio</author>
  <license>TODO: License declaration</license>

  <url type="repository">https://github.com/inria-paris-robotics-lab/prl_ur5_robot_configuration</url>
  <url type="bugtracker">https://github.com/inria-paris-robotics-lab/prl_ur5_robot_configuration/issues</url>

  <exec_depend>rospy</exec_depend>
  <depend>prl_aruco_visp</depend>
  <depend>prl_hpp</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
